# ─── CinePulse Environment Configuration (.env.example) ──────────────────────
# Copy to .env.local for local overrides. Never commit sensitive keys to git.

# ── Core Catalog Mode (Required) ──
# "demo" uses built-in fictional catalog; "tmdb" connects to real TMDB API.
CATALOG_MODE=demo

# ── Database Layer (Required / Default Provided) ──
# Local SQLite file path (default: ./data/cinepulse.db)
DATABASE_PATH=./data/cinepulse.db
# Optional: Remote LibSQL / Turso cloud connection string (e.g. libsql://your-db.turso.io)
# DATABASE_URL=
# Optional: Turso authentication token (required if DATABASE_URL is set to Turso)
# TURSO_AUTH_TOKEN=

# ── TMDB Provider (Required if CATALOG_MODE=tmdb) ──
# 32-character API key or v4 Bearer Read Access Token from themoviedb.org
TMDB_READ_TOKEN=
# ISO 3166-1 region code for theatrical release dates (e.g. US, IN, GB)
TMDB_REGION=US
# Optional provider language (blank uses TMDB default)
TMDB_LANGUAGE=

# ── Security & Origin (Optional) ──
# Explicit application URL for CSRF and origin validation (default: http://127.0.0.1:3000)
APP_ORIGIN=http://127.0.0.1:3000

# ── Authentication Services (Optional - graceful degradation) ──
# Google OAuth credentials (for direct Google sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Supabase Auth & PostgreSQL (Optional fallback)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Mailer Services (Optional - for Email OTP verification) ──
# Option A: SMTP (Gmail / Custom SMTP server)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CinePulse <noreply@cinepulse.local>"

# Option B: Resend API
# RESEND_API_KEY=

# ── Free External Data Providers (Optional - all degrade gracefully to null) ──
# YouTube Data API v3 (for trailer view velocity & comment counts)
# YOUTUBE_API_KEY=

# OMDb API Key (for external IMDb/Metascore/RT reviews, 1000 requests/day free)
# OMDB_API_KEY=

# Optional AI & News Enrichment (Optional)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# HF_TOKEN=
# GNEWS_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
