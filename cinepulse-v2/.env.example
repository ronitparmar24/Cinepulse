# ─── CinePulse Environment Configuration (.env.example) ──────────────────────
# Copy to .env.local for local overrides. Never commit sensitive keys to git.

# ── Core Catalog Mode (Required) ──
# "demo" uses built-in fictional catalog; "tmdb" connects to real TMDB API.
CATALOG_MODE=demo

# ── Database ──
# Production: Postgres (e.g. Supabase). When DATABASE_URL is a postgres:// URL it is used for
# everything and DATABASE_PATH is ignored. On Supabase use the transaction pooler
# (Project Settings → Database → Connection string → "Transaction", port 6543).
# Tables live in their own schema (default "cinepulse"), separate from Supabase's public tables.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SCHEMA=cinepulse
# DATABASE_POOL_MAX=5
#
# Local / offline: a SQLite file, used when DATABASE_URL is not set.
DATABASE_PATH=./data/cinepulse.db
#
# Requests that change data (POST/PUT/DELETE) per signed-in user or IP per minute (default 60).
# WRITE_LIMIT_PER_MINUTE=60

# ── TMDB Provider (Required if CATALOG_MODE=tmdb) ──
# 32-character API key or v4 Bearer Read Access Token from themoviedb.org
TMDB_READ_TOKEN=
# ISO 3166-1 region code for theatrical release dates (e.g. US, IN, GB)
TMDB_REGION=US
# Optional provider language (blank uses TMDB default)
TMDB_LANGUAGE=

# ── Security & Origin (Optional) ──
# Explicit application URL for CSRF and origin validation (default: http://127.0.0.1:3000)
APP_ORIGIN=http://127.0.0.1:3000

# Required in production for /api/cron/* (Vercel Cron and the GitHub AI-tick workflow send
# "Authorization: Bearer <CRON_SECRET>"). Without it, cron endpoints refuse with 503.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# Comma-separated emails allowed into /admin (AI community controls). Empty = admin closed.
# ADMIN_EMAILS=you@example.com

# Local QA only: allow the demo login, the OTP preview page and on-screen OTP codes while
# running a production build (`npm run build && npm start`) on your own machine.
# Ignored on Vercel. NEVER set this on a public server.
# ALLOW_DEV_AUTH=1

# ── Authentication Services (Optional - graceful degradation) ──
# Google OAuth credentials (for direct Google sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Supabase Auth & PostgreSQL (Optional fallback)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Mailer Services (Optional - for Email OTP verification) ──
# Option A: SMTP (Gmail / Custom SMTP server)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CinePulse <noreply@cinepulse.local>"

# Option B: Resend API
# RESEND_API_KEY=

# ── Free External Data Providers (Optional - all degrade gracefully to null) ──
# YouTube Data API v3 (for trailer view velocity & comment counts)
# YOUTUBE_API_KEY=

# OMDb API Key (for external IMDb/Metascore/RT reviews, 1000 requests/day free)
# OMDB_API_KEY=

# Optional AI & News Enrichment (Optional)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# HF_TOKEN=
# GNEWS_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ── New Free API Providers (Optional - all degrade gracefully to null) ──
# Trakt.tv (client ID from trakt.tv/oauth/applications for anticipated/trending signals)
# TRAKT_CLIENT_ID=

# Streaming Availability API (RapidAPI key for verified streaming expiry dates)
# STREAMING_AVAIL_KEY=

# Fanart.tv API Key (personal key from fanart.tv for clearart and HD movie logos)
# FANART_API_KEY=

# Cloudflare Turnstile bot check on sign-in / sign-up (both keys from the Cloudflare dashboard).
# Enforced only when BOTH are set. The site key must use the NEXT_PUBLIC_ prefix so the browser can read it.
# Enforced in production builds only: site keys are bound to their allowed hostnames and fail on 127.0.0.1.
# Set NEXT_PUBLIC_TURNSTILE_IN_DEV=1 to also enforce it under `next dev` (e.g. with Cloudflare's test keys).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Upstash Redis (REST URL and Token from upstash.com for distributed rate limits & quotas)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Ask CinePulse v9 AI Chatbot Configuration ──
# Master toggle for AI assistant (default: true; if false, operates in offline rule-based mode)
AI_ENABLED=true
# Chat LLM model (Gemini Flash default)
CHAT_MODEL=gemini-3-flash-preview
# Daily message limits
CHAT_DAILY_CAP_ANON=10
CHAT_DAILY_CAP_USER=40


# Intent classification model (cheap Groq model for routing)
# GROQ_INTENT_MODEL=openai/gpt-oss-20b
# Thread title generation model
# GROQ_TITLE_MODEL=openai/gpt-oss-20b

# ── CinePulse v10: Interest Feedback Loop ──
# Half-life in days for exponential time decay of learned affinities (default: 45)
FEEDBACK_HALF_LIFE_DAYS=45
# Exploration vs Exploitation ratio for recommendations outside top taste (default: 0.15 = 15%)
FEEDBACK_EXPLORE_RATIO=0.15
