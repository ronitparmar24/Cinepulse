# Start with no credentials. Demo mode uses original fictional titles.
CATALOG_MODE=demo
# Switch CATALOG_MODE to tmdb and enter this server-only token privately in .env.local.
# Never use NEXT_PUBLIC_ for this variable or put a token in chat/Git.
TMDB_READ_TOKEN=
TMDB_REGION=IN
# Optional provider language. Blank uses TMDB's default; it is part of cache keys.
TMDB_LANGUAGE=
# Relative to the folder where you run npm. Never put the database in public/.
DATABASE_PATH=./data/cinepulse.db
# Optional trusted origin. Leave empty for normal local use.
APP_ORIGIN=
