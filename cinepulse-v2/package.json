{
  "name": "cinepulse",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --webpack",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/db/sql-portability-scan.mjs",
    "test": "tsx --import ./tests/setup.ts --test \"tests/*.test.ts\"",
    "seed:community": "tsx scripts/seed-community.mjs",
    "unseed:community": "tsx scripts/unseed-community.mjs",
    "ai:backfill": "tsx scripts/ai-backfill.mjs",
    "ai:purge": "tsx scripts/ai-purge.mjs",
    "setup": "node scripts/setup.mjs",
    "build:training": "tsx scripts/build-training-set.ts",
    "train:model": "python scripts/train_model.py",
    "check:tmdb": "node --env-file-if-exists=.env.local scripts/check-tmdb.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "verify:supabase": "node scripts/verify-supabase-schema.mjs",
    "check:keys": "node scripts/check-all-keys.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:browser": "playwright test",
    "eval:chat": "tsx scripts/run-chat-evals.mjs",
    "test:pg": "node scripts/test-pg.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:copy-sqlite": "tsx scripts/db/copy-sqlite-to-postgres.ts",
    "db:import-supabase": "tsx scripts/db/import-supabase-public.ts",
    "lint:sql": "node scripts/db/sql-portability-scan.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
