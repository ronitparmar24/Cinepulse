# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Next.js build output ────────────────────────────────────────────────────
.next/
out/

# ─── Environment & secrets ───────────────────────────────────────────────────
# NEVER commit tokens or secrets. Use .env.local for private values.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep the safe example template
!.env.example

# ─── Database (SQLite) ───────────────────────────────────────────────────────
# The SQLite database contains real user accounts, sessions, and private data.
# It must NEVER be pushed to a public or private repo.
data/*.db
data/*.db-shm
data/*.db-wal
data/backups/
!data/model-weights.json
*.db
*.db-shm
*.db-wal

# ─── TypeScript build cache ───────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ─── Testing artefacts ───────────────────────────────────────────────────────
playwright-report/
test-results/
# Playwright browser binaries (very large, installed locally via npx playwright install)
/test-browsers/

# ─── OS & editor noise ───────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains IDEs
.idea/
*.iml

# Vim/Neovim
*.swp
*.swo
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Optional tooling ─────────────────────────────────────────────────────────
.yarn/
.pnp.*
.vercel
.turbo/

# ─── Keep these in the repo ──────────────────────────────────────────────────
# (these lines are not needed — Git includes files unless told otherwise,
#  listed here for clarity)
# public/assets/*.webp — demo artwork, intentionally committed
# .env.example — safe template with no credentials
# package-lock.json — reproducible installs
